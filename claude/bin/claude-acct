#!/usr/bin/env python3
"""claude-acct — switch Claude Code accounts without re-login, and show usage.

  claude-acct save [name]   snapshot the current login into the store (default name = email)
  claude-acct use           table of every saved account: Fable weekly used + reset time
                            (enterprise accounts: credit spend `$used / $limit`; no reset date)
  claude-acct use <name>    save current login, swap <name> in, then show its usage
  claude-acct list          same table as bare `use`
  claude-acct rm <name>     delete a saved account

Store: ~/.claude-accounts/<name>.json (mode 600). Each entry holds the raw
.credentials.json content plus the oauthAccount block from .claude.json.

Why save-before-use: Claude Code rotates the refresh token whenever it refreshes
the access token and rewrites .credentials.json, so the store copy of the
CURRENT account must be re-snapshotted before another account is swapped in.

The running claude binary watches .credentials.json (mtime) and drops its
in-memory token cache on change, so live sessions follow the swap.
"""
import json
import os
import sys
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

CFG = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
CRED = os.path.join(CFG, ".credentials.json")
CLAUDE_JSON = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~"), ".claude.json")
STORE = os.path.expanduser("~/.claude-accounts")

# Same client the Claude Code binary uses (constants read from the 2.1.257 bundle).
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
OAUTH_BETA = "oauth-2025-04-20"
DEFAULT_SCOPES = ["user:profile", "user:inference", "user:sessions:claude_code", "user:mcp_servers", "user:file_upload"]
REFRESH_MARGIN_S = 120


# ---------------------------------------------------------------- file helpers
def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def write_json_atomic(path, data, mode=0o600):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)  # atomic: a running claude never sees a half-written file


def entry_path(name):
    if not name or "/" in name or name.startswith("."):
        die(f"invalid account name {name!r}")
    return os.path.join(STORE, f"{name}.json")


def load_entry(name):
    e = read_json(entry_path(name))
    if e is None:
        die(f"no saved account {name!r} (run `claude-acct list`)")
    return e


def save_entry(name, entry):
    os.makedirs(STORE, mode=0o700, exist_ok=True)
    os.chmod(STORE, 0o700)
    write_json_atomic(entry_path(name), entry)


def list_names():
    if not os.path.isdir(STORE):
        return []
    return sorted(f[:-5] for f in os.listdir(STORE) if f.endswith(".json"))


def die(msg, code=1):
    print(f"claude-acct: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- live login
def live_login():
    """(credentials dict, oauthAccount dict) of the current login, or (None, None)."""
    cred = read_json(CRED)
    acct = (read_json(CLAUDE_JSON, {}) or {}).get("oauthAccount") or {}
    if not cred or not cred.get("claudeAiOauth", {}).get("accessToken"):
        return None, None
    return cred, acct


def live_identity(acct):
    return acct.get("accountUuid") or acct.get("emailAddress")


def entry_identity(entry):
    a = entry.get("oauthAccount") or {}
    return a.get("accountUuid") or a.get("emailAddress")


def name_for_current(acct):
    """Store name that already holds the current account, else its email."""
    ident = live_identity(acct)
    for n in list_names():
        if ident and entry_identity(load_entry(n)) == ident:
            return n
    return acct.get("emailAddress") or "default"


def snapshot_current(name=None):
    cred, acct = live_login()
    if cred is None:
        return None
    name = name or name_for_current(acct)
    save_entry(name, {"credentials": cred, "oauthAccount": acct, "savedAt": int(time.time())})
    return name


def current_name():
    _, acct = live_login()
    if acct is None:
        return None
    ident = live_identity(acct)
    for n in list_names():
        if ident and entry_identity(load_entry(n)) == ident:
            return n
    return None


# ---------------------------------------------------------------- OAuth
def http_json(url, method="GET", body=None, token=None, timeout=15):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    req.add_header("anthropic-beta", OAUTH_BETA)
    req.add_header("User-Agent", "claude-acct/1.0")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read().decode() or "null")
    except urllib.error.HTTPError as e:
        try:
            payload = json.loads(e.read().decode())
        except Exception:
            payload = None
        return e.code, payload


def token_expired(oauth):
    exp = oauth.get("expiresAt")
    return not exp or exp / 1000 <= time.time() + REFRESH_MARGIN_S


def refresh(oauth):
    """Refresh an OAuth block; returns the new block (rotated refresh token) or raises."""
    body = {
        "grant_type": "refresh_token",
        "refresh_token": oauth["refreshToken"],
        "client_id": CLIENT_ID,
        "scope": " ".join(oauth.get("scopes") or DEFAULT_SCOPES),
    }
    status, resp = http_json(TOKEN_URL, "POST", body, timeout=30)
    if status != 200 or not resp or "access_token" not in resp:
        raise RuntimeError(f"token refresh failed ({status}): {json.dumps(resp)[:200]}")
    new = dict(oauth)
    new["accessToken"] = resp["access_token"]
    new["refreshToken"] = resp.get("refresh_token") or oauth["refreshToken"]
    new["expiresAt"] = int((time.time() + resp.get("expires_in", 3600)) * 1000)
    if resp.get("scope"):
        new["scopes"] = resp["scope"].split()
    return new


def ensure_fresh(name, entry, is_current):
    """Return a usable access token for a store entry, refreshing (and persisting) if needed."""
    if is_current:
        # The live file is the source of truth for the current account: a running
        # session may already have refreshed it (refresh tokens are single-use).
        live, _ = live_login()
        if live:
            entry["credentials"] = live
    oauth = entry["credentials"]["claudeAiOauth"]
    if not token_expired(oauth):
        return oauth["accessToken"]
    new = refresh(oauth)
    entry["credentials"]["claudeAiOauth"] = new
    entry["savedAt"] = int(time.time())
    save_entry(name, entry)
    if is_current:
        write_json_atomic(CRED, entry["credentials"])
    return new["accessToken"]


# ---------------------------------------------------------------- usage
def fetch_usage(token):
    status, data = http_json(USAGE_URL, token=token, timeout=15)
    if status != 200:
        raise RuntimeError(f"usage endpoint {status}: {json.dumps(data)[:160]}")
    return data


def pick_spend(usage):
    """Enterprise credit spend block: used / limit in dollars. Returns None if not enabled."""
    sp = usage.get("spend")
    if not sp or not sp.get("enabled"):
        return None
    def to_dollars(block):
        if not block:
            return None
        minor = block.get("amount_minor")
        exp = block.get("exponent", 2)
        return None if minor is None else minor / (10 ** exp)
    used_d = to_dollars(sp.get("used"))
    limit_d = to_dollars(sp.get("limit"))
    return {"used": used_d, "limit": limit_d} if used_d is not None else None


def fmt_spend(spend):
    """Format spend as '$485.06 / $10,000.00'."""
    if not spend:
        return "-"
    used, limit = spend.get("used"), spend.get("limit")
    used_s = f"${used:,.2f}" if used is not None else "?"
    limit_s = f"${limit:,.2f}" if limit is not None else "?"
    return f"{used_s} / {limit_s}"


def pick_fable(usage):
    """Fable weekly window: server limits[] entry whose model label is Fable, else seven_day_opus."""
    fable = [
        lim for lim in (usage.get("limits") or [])
        if "fable" in ((((lim.get("scope") or {}).get("model") or {}).get("display_name") or "").lower())
    ]
    weekly = [lim for lim in fable if "seven" in f"{lim.get('kind', '')} {lim.get('group', '')}"] or fable
    if weekly:
        lim = weekly[0]
        model = ((lim.get("scope") or {}).get("model") or {}).get("display_name")
        return {"utilization": lim.get("percent"), "resets_at": lim.get("resets_at"), "label": f"{model} weekly"}
    w = usage.get("seven_day_opus")
    if w:
        return {"utilization": w.get("utilization"), "resets_at": w.get("resets_at"), "label": "Opus/Fable weekly"}
    return None


def fmt_reset(iso):
    if not iso:
        return "-"
    try:
        t = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return iso
    secs = int((t - datetime.now(timezone.utc)).total_seconds())
    if secs <= 0:
        rel = "now"
    else:
        d, rem = divmod(secs, 86400)
        h, rem = divmod(rem, 3600)
        m = rem // 60
        rel = f"{d}d {h}h" if d else (f"{h}h {m:02d}m" if h else f"{m}m")
    return f"{t.astimezone().strftime('%a %m-%d %H:%M')} (in {rel})"


def fmt_pct_used(u):
    if u is None:
        return "-"
    return f"{float(u):5.1f}%"


def usage_row(name, entry, is_current):
    try:
        token = ensure_fresh(name, entry, is_current)
        usage = fetch_usage(token)
    except Exception as e:  # keep the table going for the other accounts
        return {"name": name, "error": str(e)}
    fable = pick_fable(usage) or {}
    spend = pick_spend(usage)
    return {
        "name": name,
        "email": (entry.get("oauthAccount") or {}).get("emailAddress", ""),
        "plan": entry["credentials"]["claudeAiOauth"].get("subscriptionType", ""),
        "fable_used": fmt_pct_used(fable.get("utilization")) if fable else fmt_spend(spend),
        "fable_reset": fmt_reset(fable.get("resets_at")),
    }


def show_usage(names):
    cur = current_name()
    entries = {n: load_entry(n) for n in names}
    with ThreadPoolExecutor(max_workers=max(1, len(names))) as ex:
        rows = list(ex.map(lambda n: usage_row(n, entries[n], n == cur), names))
    for r in rows:  # show the account once: the email only when it differs from the store name
        email = r.get("email", "")
        r["label"] = r["name"] if email in ("", r["name"]) else f"{r['name']} ({email})"
    w = max([len(r["label"]) for r in rows] + [7])
    pw = max([len(r.get("plan", "")) for r in rows] + [4])
    uw = max([len(r.get("fable_used", "")) for r in rows if "error" not in r] + [len("Fable weekly used")])
    print(f"  {'account':<{w}}  {'plan':<{pw}}  {'Fable weekly used':>{uw}}  resets")
    for r in rows:
        mark = "*" if r["name"] == cur else " "
        if "error" in r:
            print(f"{mark} {r['label']:<{w}}  !! {r['error']}")
            continue
        print(f"{mark} {r['label']:<{w}}  {r['plan']:<{pw}}  {r['fable_used']:>{uw}}  {r['fable_reset']}")
    if not cur:
        print("\n(no saved account matches the active login; run `claude-acct save` first)")


# ---------------------------------------------------------------- commands
def cmd_save(name=None):
    n = snapshot_current(name)
    if n is None:
        die(f"no active login in {CRED}; run /login in Claude Code first")
    print(f"saved {n} -> {entry_path(n)}")


def cmd_use(name=None):
    names = list_names()
    if name is None:
        if not names:
            die("no saved accounts; run `claude-acct save` while logged in")
        show_usage(names)
        return
    entry = load_entry(name)
    cur = snapshot_current()  # keep the current account's rotated refresh token
    if cur == name:
        print(f"{name} is already the active login")
    else:
        write_json_atomic(CRED, entry["credentials"])
        cj = read_json(CLAUDE_JSON, {}) or {}
        cj["oauthAccount"] = entry.get("oauthAccount") or {}
        write_json_atomic(CLAUDE_JSON, cj, mode=0o644)
        print(f"switched {cur or '(unsaved)'} -> {name}  [{(entry.get('oauthAccount') or {}).get('emailAddress', '')}]")
    show_usage([name])


def cmd_list():
    names = list_names()
    if not names:
        die("no saved accounts; run `claude-acct save` while logged in")
    show_usage(names)


def cmd_rm(name):
    p = entry_path(name)
    if not os.path.exists(p):
        die(f"no saved account {name!r}")
    os.remove(p)
    print(f"removed {name}")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "use"
    arg = argv[2] if len(argv) > 2 else None
    if cmd == "save":
        cmd_save(arg)
    elif cmd == "use":
        cmd_use(arg)
    elif cmd == "list":
        cmd_list()
    elif cmd == "rm":
        if not arg:
            die("rm needs a name")
        cmd_rm(arg)
    elif cmd == "raw":  # dump the usage endpoint JSON (no tokens) for one account, for debugging
        name = arg or current_name() or die("raw needs a name (no saved account matches the active login)")
        print(json.dumps(fetch_usage(ensure_fresh(name, load_entry(name), name == current_name())), indent=2))
    else:
        print(__doc__.strip())
        sys.exit(0 if cmd in ("-h", "--help", "help") else 1)


if __name__ == "__main__":
    main(sys.argv)
